# Cloudflare R2: account id (dashboard → R2 → right-hand side) and an API token with
# "Object Read & Write" for this bucket only (R2 → Manage API tokens).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=uplift
# Folder on the HDDs for the raw messages and the running status (e.g. in your snapshotted share).
UPLIFT_DATA=/path/to/moti/uplift
# User and group that should own the files there (check with: id yourname).
PUID=1000
PGID=1000
